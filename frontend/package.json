{
  "name": "yoga-studio-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:db:up": "docker compose -f ../docker-compose.e2e.yml -p yoga-e2e up -d --wait",
    "e2e:db:down": "docker compose -f ../docker-compose.e2e.yml -p yoga-e2e down",
    "e2e:backend": "node scripts/e2e-backend.cjs",
    "e2e:frontend": "E2E_COVERAGE=true vite --host 127.0.0.1 --port 3001 --strictPort",
    "e2e:run": "node scripts/e2e-clean.cjs && node scripts/cypress.cjs run && nyc check-coverage",
    "e2e:open": "node scripts/cypress.cjs open",
    "test:e2e": "npm run e2e:db:up && start-server-and-test e2e:backend http-get://127.0.0.1:8082/api/health e2e:frontend http://127.0.0.1:3001 e2e:run",
    "test:e2e:open": "npm run e2e:db:up && start-server-and-test e2e:backend http-get://127.0.0.1:8082/api/health e2e:frontend http://127.0.0.1:3001 e2e:open"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.4",
    "jsdom": "^29.1.1",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^5.0.1",
    "cypress": "^16.1.0",
    "nyc": "^18.0.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.1"
  }
}
