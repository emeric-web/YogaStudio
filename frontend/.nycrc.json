{
  "report-dir": "../tests-coverage/e2e",
  "temp-dir": ".nyc_output",
  "reporter": ["text", "html", "lcov", "json-summary"],
  "include": ["src/**/*.{ts,tsx}"],
  "exclude": ["src/**/*.{test,spec}.{ts,tsx}", "src/**/*.d.ts", "src/setupTests.ts", "src/types/**"],
  "check-coverage": true,
  "statements": 80,
  "branches": 80,
  "functions": 80,
  "lines": 80
}
